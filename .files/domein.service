[Unit]
Description=domein DNS control board
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=domein
Group=domein
WorkingDirectory=/opt/domein
EnvironmentFile=/etc/domein.env
Environment=DOMEIN_DATA_DIR=/var/lib/domein
ExecStart=/opt/domein/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
